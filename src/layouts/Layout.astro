---
import { ClientRouter } from "astro:transitions";
import SeoHead from "../components/SeoHead.astro";

import "../styles/global.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
const description =
  "Yonatan Paripsky is a Senior Software Engineer focused on JavaScript, React, Node.js, cloud platforms, and building thoughtful software products.";
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Yonatan Paripsky",
  url: new URL("/", Astro.site).href,
  jobTitle: "Senior Software Engineer",
  sameAs: [
    "https://github.com/paripsky",
    "https://www.linkedin.com/in/paripsky",
  ],
  knowsAbout: [
    "JavaScript",
    "React",
    "Node.js",
    "Cloud platforms",
    "Software engineering",
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <SeoHead
      title={title}
      description={description}
      image="/images/seo/home.jpg"
      imageAlt="Yonatan Paripsky, Senior Software Engineer"
    />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#020617" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <ClientRouter />
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-1YD1ZSVP59"
    ></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());

      gtag("config", "G-1YD1ZSVP59");
    </script>
  </head>
  <body
    class="flex min-h-screen flex-col items-center bg-slate-950 text-white relative"
    style="color-scheme: dark;"
  >
    <slot />
    <script is:inline>
      document.addEventListener("astro:page-load", () => {
        if (!window.matchMedia("(pointer: fine)").matches) return;

        const cards = document.querySelectorAll("[data-spotlight]");

        function handleCardsSpotlightPosition(e) {
          cards.forEach((card) => {
            const rect = card.getBoundingClientRect();
            const x = e.clientX - rect.left;
            const y = e.clientY - rect.top;

            card.style.setProperty("--x", `${x}px`);
            card.style.setProperty("--y", `${y}px`);
          });
        }

        document.addEventListener("mousemove", handleCardsSpotlightPosition);
        document.addEventListener("wheel", handleCardsSpotlightPosition);
      });
    </script>
  </body>
</html>
