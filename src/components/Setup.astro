---
import type { ImageMetadata } from "astro";
import ProductRow from "./ProductRow.astro";
import corsairGalleon from "../assets/setup/corsair-galleon-no-cable.png";
import codexMicro from "../assets/setup/codex-micro.png";
import nuphyAir75 from "../assets/setup/nuphy-air75.png";
import logitechG515 from "../assets/setup/logitech-g515.png";
import logitechG815 from "../assets/setup/logitech-g815.png";
import akkoMonetsPond from "../assets/setup/akko-monets-pond.png";
import appleMagicKeyboard from "../assets/setup/apple-magic-keyboard-white.png";

type Keyboard = {
  name: string;
  href: string;
  image: ImageMetadata;
  alt: string;
  note: string;
  attributes: string[];
  previewWidths: number[];
};

const currentDevices: Keyboard[] = [
  {
    name: "Corsair GALLEON 100 SD",
    href: "https://www.corsair.com/us/en/p/keyboards/ch-912a31i-na/galleon-100-sd-stream-deck-integrated-mechanical-keyboard-ch-912a31i-na",
    image: corsairGalleon,
    alt: "Corsair GALLEON 100 SD mechanical keyboard with its wrist rest",
    note: "This is the keyboard on my desk now. It puts a full-size mechanical board, Stream Deck keys, a screen, and two dials in one device.",
    attributes: ["Full-size", "Mechanical", "Stream Deck built in"],
    previewWidths: [176, 264, 352, 800, 1400, 2000],
  },
  {
    name: "Work Louder Codex Micro",
    href: "https://worklouder.cc/codex-micro",
    image: codexMicro,
    alt: "White Work Louder Codex Micro macro pad with illuminated keys, a dial, and a joystick",
    note: "A compact macro pad I use with Codex. It combines 13 mechanical keys with a dial, joystick, and touch sensor.",
    attributes: ["13 keys", "Dial + joystick", "Bluetooth / USB-C"],
    previewWidths: [176, 264, 352, 720, 1200],
  },
];

const keyboards: Keyboard[] = [
  {
    name: "NuPhy Air75",
    href: "https://nuphy.com/products/air75",
    image: nuphyAir75,
    alt: "Original NuPhy Air75 low-profile mechanical keyboard",
    note: "The smallest mechanical board in the collection. Its 75% layout keeps the function row while leaving more room on the desk.",
    attributes: ["75%", "Low-profile", "Wireless"],
    previewWidths: [160, 240, 320, 720, 1200],
  },
  {
    name: "Logitech G515",
    href: "https://www.logitechg.com/en-us/products/gaming-keyboards/g515-tkl-wireless-keyboard.html",
    image: logitechG515,
    alt: "White Logitech G515 TKL low-profile keyboard",
    note: "A white, low-profile TKL that can switch between LIGHTSPEED, Bluetooth, and a wired connection.",
    attributes: ["TKL", "Low-profile", "Wireless"],
    previewWidths: [160, 240, 320, 800, 1400, 1800],
  },
  {
    name: "Logitech G815",
    href: "https://www.logitechg.com/en-us/shop/p/g815-low-profile-rgb-mechanical-gaming-keyboard",
    image: logitechG815,
    alt: "Logitech G815 full-size low-profile mechanical keyboard",
    note: "A wired, full-size low-profile board with five G-keys and dedicated media controls.",
    attributes: ["Full-size", "Low-profile", "Wired"],
    previewWidths: [160, 240, 320, 800, 1400, 1800],
  },
  {
    name: "Akko Monet's Pond 3108v2",
    href: "https://en.akkogear.com/product/monets-pond-3108v2-mechanical-keyboard/",
    image: akkoMonetsPond,
    alt: "Akko Monet's Pond 3108v2 mechanical keyboard in turquoise and white",
    note: "The colorful one. Its keycaps use koi, water lilies, and Japanese legends inspired by Monet's Pond.",
    attributes: ["Full-size", "Mechanical", "PBT keycaps"],
    previewWidths: [160, 240, 320, 560, 720],
  },
  {
    name: "Apple Magic Keyboard",
    href: "https://www.apple.com/shop/product/mxk73ll/a/magic-keyboard-with-touch-id-and-numeric-keypad-for-mac-models-with-apple-silicon-usb-c-us-english-white-keys",
    image: appleMagicKeyboard,
    alt: "Silver and white Apple Magic Keyboard with Touch ID and numeric keypad",
    note: "The Apple option: a thin silver and white wireless board with Touch ID, full-size arrow keys, and a number pad.",
    attributes: ["Touch ID", "Numeric keypad", "Wireless"],
    previewWidths: [160, 240, 320, 800, 1400, 1800],
  },
];
---

<div class="flex flex-col gap-10">
  <div class="flex flex-col gap-4">
    <h3 class="font-mono text-xs uppercase tracking-[0.18em] text-neutral-500">
      On the desk
    </h3>
    <ul class="divide-y divide-zinc-800 border-y border-zinc-800">
      {currentDevices.map((device) => <ProductRow product={device} featured />)}
    </ul>
  </div>

  <div class="flex flex-col gap-4">
    <h3 class="font-mono text-xs uppercase tracking-[0.18em] text-neutral-500">
      On the shelf
    </h3>
    <ul class="divide-y divide-zinc-800 border-y border-zinc-800">
      {keyboards.map((keyboard) => <ProductRow product={keyboard} />)}
    </ul>
  </div>
</div>
