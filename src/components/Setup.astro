---
import type { ImageMetadata } from "astro";
import { Icon } from "astro-icon/components";
import KeyboardRow from "./KeyboardRow.astro";
import corsairGalleon from "../assets/setup/corsair-galleon-no-cable.png";
import codexMicro from "../assets/setup/codex-micro.png";
import nuphyAir75 from "../assets/setup/nuphy-air75.png";
import logitechG515 from "../assets/setup/logitech-g515.png";
import logitechG815 from "../assets/setup/logitech-g815.png";
import akkoMonetsPond from "../assets/setup/akko-monets-pond.png";
import appleMagicKeyboard from "../assets/setup/apple-magic-keyboard-white.png";

type Keyboard = {
  name: string;
  href: string;
  image: ImageMetadata;
  alt: string;
  note: string;
  attributes: string[];
  previewWidths: number[];
  currentLabel?: string;
};

const currentDevices: Keyboard[] = [
  {
    name: "Corsair GALLEON 100 SD",
    href: "https://www.corsair.com/us/en/p/keyboards/ch-912a31i-na/galleon-100-sd-stream-deck-integrated-mechanical-keyboard-ch-912a31i-na",
    image: corsairGalleon,
    alt: "Corsair GALLEON 100 SD mechanical keyboard with its wrist rest",
    note: "This is the keyboard on my desk now. It puts a full-size mechanical board, Stream Deck keys, a screen, and two dials in one device.",
    attributes: ["Full-size", "Mechanical", "Stream Deck built in"],
    previewWidths: [176, 264, 352, 800, 1400, 2000],
    currentLabel: "Current keyboard",
  },
  {
    name: "Work Louder Codex Micro",
    href: "https://worklouder.cc/codex-micro",
    image: codexMicro,
    alt: "White Work Louder Codex Micro macro pad with illuminated keys, a dial, and a joystick",
    note: "A compact macro pad I use with Codex. It combines 13 mechanical keys with a dial, joystick, and touch sensor.",
    attributes: ["13 keys", "Dial + joystick", "Bluetooth / USB-C"],
    previewWidths: [176, 264, 352, 720, 1200],
    currentLabel: "Current macro pad",
  },
];

const keyboards: Keyboard[] = [
  {
    name: "NuPhy Air75",
    href: "https://nuphy.com/products/air75",
    image: nuphyAir75,
    alt: "Original NuPhy Air75 low-profile mechanical keyboard",
    note: "The smallest mechanical board in the collection. Its 75% layout keeps the function row while leaving more room on the desk.",
    attributes: ["75%", "Low-profile", "Wireless"],
    previewWidths: [160, 240, 320, 720, 1200],
  },
  {
    name: "Logitech G515",
    href: "https://www.logitechg.com/en-us/products/gaming-keyboards/g515-tkl-wireless-keyboard.html",
    image: logitechG515,
    alt: "White Logitech G515 TKL low-profile keyboard",
    note: "A white, low-profile TKL that can switch between LIGHTSPEED, Bluetooth, and a wired connection.",
    attributes: ["TKL", "Low-profile", "Wireless"],
    previewWidths: [160, 240, 320, 800, 1400, 1800],
  },
  {
    name: "Logitech G815",
    href: "https://www.logitechg.com/en-us/shop/p/g815-low-profile-rgb-mechanical-gaming-keyboard",
    image: logitechG815,
    alt: "Logitech G815 full-size low-profile mechanical keyboard",
    note: "A wired, full-size low-profile board with five G-keys and dedicated media controls.",
    attributes: ["Full-size", "Low-profile", "Wired"],
    previewWidths: [160, 240, 320, 800, 1400, 1800],
  },
  {
    name: "Akko Monet's Pond 3108v2",
    href: "https://en.akkogear.com/product/monets-pond-3108v2-mechanical-keyboard/",
    image: akkoMonetsPond,
    alt: "Akko Monet's Pond 3108v2 mechanical keyboard in turquoise and white",
    note: "The colorful one. Its keycaps use koi, water lilies, and Japanese legends inspired by Monet's Pond.",
    attributes: ["Full-size", "Mechanical", "PBT keycaps"],
    previewWidths: [160, 240, 320, 560, 720],
  },
  {
    name: "Apple Magic Keyboard",
    href: "https://www.apple.com/shop/product/mxk73ll/a/magic-keyboard-with-touch-id-and-numeric-keypad-for-mac-models-with-apple-silicon-usb-c-us-english-white-keys",
    image: appleMagicKeyboard,
    alt: "Silver and white Apple Magic Keyboard with Touch ID and numeric keypad",
    note: "The Apple option: a thin silver and white wireless board with Touch ID, full-size arrow keys, and a number pad.",
    attributes: ["Touch ID", "Numeric keypad", "Wireless"],
    previewWidths: [160, 240, 320, 800, 1400, 1800],
  },
];
---

<div class="flex flex-col gap-10">
  <div class="flex flex-col gap-4">
    <h3 class="font-mono text-xs uppercase tracking-[0.18em] text-neutral-500">
      On the desk
    </h3>
    <ul class="divide-y divide-zinc-800 border-y border-zinc-800">
      {currentDevices.map((device) => <KeyboardRow keyboard={device} current />)}
    </ul>
  </div>

  <div class="flex flex-col gap-4">
    <h3 class="font-mono text-xs uppercase tracking-[0.18em] text-neutral-500">
      On the shelf
    </h3>
    <ul class="divide-y divide-zinc-800 border-y border-zinc-800">
      {keyboards.map((keyboard) => <KeyboardRow keyboard={keyboard} />)}
    </ul>
  </div>
</div>

<dialog
  id="keyboard-preview"
  aria-labelledby="keyboard-preview-title"
  class="keyboard-dialog m-auto border-0 bg-transparent p-0 text-white"
>
  <div
    class="preview-panel relative flex h-full flex-col items-center justify-center gap-5 overflow-hidden rounded-2xl bg-slate-950/95 p-5 sm:p-8"
  >
    <button
      type="button"
      data-preview-close
      aria-label="Close image preview"
      class="preview-close absolute right-4 top-4 z-20 rounded-full border border-zinc-700 bg-slate-900/90 p-2 text-neutral-400 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-300"
    >
      <Icon name="mdi:close" class="size-5" />
    </button>
    <img
      data-preview-image
      class="min-h-0 max-h-[72vh] w-full object-contain"
      alt=""
    />
    <p
      id="keyboard-preview-title"
      data-preview-title
      class="shrink-0 text-sm font-medium text-neutral-300"
    >
    </p>
  </div>
</dialog>

<style>
  .keyboard-dialog {
    --ease-out: cubic-bezier(0.23, 1, 0.32, 1);
    width: min(94vw, 1120px);
    height: min(88vh, 820px);
    max-width: none;
    max-height: none;
    transform-origin: center;
  }

  .keyboard-dialog[open] {
    opacity: 1;
    transform: translateY(0) scale(1);
    transition:
      opacity 180ms var(--ease-out),
      transform 220ms var(--ease-out);
  }

  .keyboard-dialog::backdrop {
    background: rgb(2 6 23 / 0.88);
    backdrop-filter: blur(12px);
  }

  .keyboard-dialog[open]::backdrop {
    opacity: 1;
    transition: opacity 180ms var(--ease-out);
  }

  .preview-panel {
    box-shadow: 0 30px 100px rgb(0 0 0 / 0.55);
  }

  .preview-close {
    transition:
      color 140ms ease,
      transform 140ms var(--ease-out);
  }

  .preview-close:active {
    transform: scale(0.97);
  }

  @starting-style {
    .keyboard-dialog[open] {
      opacity: 0;
      transform: translateY(12px) scale(0.965);
    }

    .keyboard-dialog[open]::backdrop {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .keyboard-dialog[open] {
      transform: none;
      transition: opacity 140ms ease-out;
    }

    .keyboard-dialog[open]::backdrop {
      transition: opacity 140ms ease-out;
    }

    @starting-style {
      .keyboard-dialog[open] {
        opacity: 0;
        transform: none;
      }
    }
  }
</style>

<style is:global>
  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation: none;
    mix-blend-mode: normal;
  }

  ::view-transition-group(keyboard-preview-image) {
    z-index: 2147483647;
    animation-duration: 260ms;
    animation-timing-function: cubic-bezier(0.77, 0, 0.175, 1);
  }

  ::view-transition-old(keyboard-preview-image),
  ::view-transition-new(keyboard-preview-image) {
    animation: none;
    height: 100%;
    mix-blend-mode: normal;
    object-fit: contain;
  }

  @media (prefers-reduced-motion: reduce) {
    ::view-transition-group(keyboard-preview-image) {
      animation: none;
    }
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const dialog = document.querySelector<HTMLDialogElement>("#keyboard-preview");
    const previewImage = dialog?.querySelector<HTMLImageElement>("[data-preview-image]");
    const previewTitle = dialog?.querySelector<HTMLElement>("[data-preview-title]");

    if (dialog && previewImage && previewTitle && !dialog.dataset.previewReady) {
      dialog.dataset.previewReady = "true";
      let previewRequest = 0;
      let transitionRun = 0;
      let activeSource: HTMLImageElement | null = null;

      const transitionDocument = document as Document & {
        startViewTransition?: (update: () => void) => { finished: Promise<void> };
      };
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

      const closePreview = () => {
        if (!dialog.open) return;

        const source = activeSource;
        if (!source?.isConnected || !transitionDocument.startViewTransition || reduceMotion.matches) {
          transitionRun++;
          dialog.close();
          activeSource = null;
          return;
        }

        const run = ++transitionRun;
        previewImage.style.viewTransitionName = "keyboard-preview-image";
        const transition = transitionDocument.startViewTransition(() => {
          previewImage.style.viewTransitionName = "";
          source.style.viewTransitionName = "keyboard-preview-image";
          dialog.close();
        });
        const clearTransitionNames = () => {
          if (run !== transitionRun) return;
          source.style.viewTransitionName = "";
          previewImage.style.viewTransitionName = "";
          activeSource = null;
        };

        transition.finished.then(clearTransitionNames, clearTransitionNames);
      };

      document.querySelectorAll<HTMLButtonElement>("[data-keyboard-preview]").forEach((button) => {
        button.addEventListener("click", async () => {
          const source = button.querySelector<HTMLImageElement>("img");
          if (!source) return;

          const sources = source.srcset
            .split(",")
            .map((candidate) => candidate.trim().split(/\s+/)[0])
            .filter(Boolean);

          const nextSource = sources.at(-1) ?? source.currentSrc ?? source.src;
          const request = ++previewRequest;
          const nextImage = new Image();
          nextImage.src = nextSource;

          try {
            await nextImage.decode();
          } catch {
            if (!nextImage.complete) return;
          }

          if (request !== previewRequest) return;
          activeSource = source;

          const openPreview = () => {
            previewImage.src = nextSource;
            previewImage.alt = source.alt;
            previewTitle.textContent = source.alt;
            dialog.showModal();
          };

          if (!transitionDocument.startViewTransition || reduceMotion.matches) {
            openPreview();
            return;
          }

          const run = ++transitionRun;
          source.style.viewTransitionName = "keyboard-preview-image";
          const transition = transitionDocument.startViewTransition(() => {
            source.style.viewTransitionName = "";
            previewImage.style.viewTransitionName = "keyboard-preview-image";
            openPreview();
          });
          const clearTransitionNames = () => {
            if (run !== transitionRun) return;
            source.style.viewTransitionName = "";
            previewImage.style.viewTransitionName = "";
          };

          transition.finished.then(clearTransitionNames, clearTransitionNames);
        });
      });

      dialog.querySelector<HTMLButtonElement>("[data-preview-close]")?.addEventListener("click", () => {
        closePreview();
      });

      dialog.addEventListener("click", (event) => {
        if (event.target === dialog) closePreview();
      });

      dialog.addEventListener("cancel", (event) => {
        event.preventDefault();
        closePreview();
      });

      dialog.addEventListener("close", () => {
        previewRequest++;
        previewImage.style.viewTransitionName = "";
        previewImage.removeAttribute("src");
        previewImage.alt = "";
        previewTitle.textContent = "";
      });
    }

    if (
      !window.matchMedia("(pointer: fine)").matches ||
      window.matchMedia("(prefers-reduced-motion: reduce)").matches
    )
      return;

    document.querySelectorAll<HTMLElement>("[data-product-tilt]").forEach((element) => {
      if (element.dataset.tiltReady) return;
      element.dataset.tiltReady = "true";
      let frame = 0;

      element.addEventListener("pointermove", (event) => {
        cancelAnimationFrame(frame);
        frame = requestAnimationFrame(() => {
          const rect = element.getBoundingClientRect();
          const x = (event.clientX - rect.left) / rect.width;
          const y = (event.clientY - rect.top) / rect.height;
          const maxTilt = Number(element.dataset.maxTilt ?? 3);

          element.style.setProperty("--tilt-x", `${(0.5 - y) * maxTilt * 2}deg`);
          element.style.setProperty("--tilt-y", `${(x - 0.5) * maxTilt * 2}deg`);
          element.style.setProperty("--shadow-x", `${(0.5 - x) * 14}px`);
        });
      });

      element.addEventListener("pointerleave", () => {
        cancelAnimationFrame(frame);
        element.style.setProperty("--tilt-x", "0deg");
        element.style.setProperty("--tilt-y", "0deg");
        element.style.setProperty("--shadow-x", "0px");
      });
    });
  });
</script>
