---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import freshLogo from "../assets/fresh-logo.svg";

const projects = [
  {
    title: "Devedash",
    color: "59 130 246",
    background: "#0c1e38",
    description:
      "Devedash is a dashboard building app, built with Next.js, Mantine UI and Supabase.",
    githubUrl: "https://github.com/paripsky/devedash",
    siteUrl: "https://devedash.vercel.app/",
    image: "https://devedash.vercel.app/favicon.ico",
    tags: ["Next", "Supabase"],
  },
  {
    title: "FreshLinks",
    color: "250 204 21",
    background: "#2b2412",
    description:
      "A short link generator with built in analytics, built with Fresh and Deno KV.",
    githubUrl: "https://github.com/paripsky/FreshLinks",
    image: freshLogo,
    tags: ["Deno", "Fresh"],
  },
  {
    title: "OG Scrapi",
    color: "203 213 225",
    background: "#20242c",
    description:
      "An API for fetching Open Graph tags and other metadata from any URL.",
    githubUrl: "https://github.com/paripsky/og-scrapi",
    image: "https://upload.wikimedia.org/wikipedia/commons/e/e8/Deno_2021.svg",
    tags: ["Deno", "TS"],
  },
  {
    title: "Develist",
    color: "168 85 247",
    background: "#23172f",
    description:
      "An app for organizing development tools and resources, built with Nuxt 3 and Supabase.",
    githubUrl: "https://github.com/paripsky/develist",
    siteUrl:
      "https://develist.vercel.app/?link=b07aab82-0905-41fd-93b8-6f19ce2bdfb5",
    image: "https://develist.vercel.app/favicon.ico",
    tags: ["Nuxt", "Supabase"],
  },
  {
    title: "node-context-storage",
    color: "74 222 128",
    background: "#122a20",
    description: `A simple utility for managing a context across asynchronous boundaries in NodeJS.`,
    githubUrl: "https://github.com/paripsky/node-context-storage",
    siteUrl: "https://www.npmjs.com/package/node-context-storage",
    image: "https://nodejs.org/static/images/logo.svg",
    tags: ["Node", "Express"],
  },
  {
    title: "QTerminal",
    color: "251 146 60",
    background: "#302019",
    description: "A Quake-style console for your website.",
    githubUrl: "https://github.com/paripsky/qterminal",
    siteUrl: "https://paripsky.github.io/qterminal",
    image:
      "https://upload.wikimedia.org/wikipedia/commons/5/51/Windows_Terminal_logo.svg",
    tags: ["Typescript", "CSS"],
  },
];
---

<ul class="grid grid-cols-1 xl:grid-cols-2 gap-4 w-full">
  {
    projects.map((project) => (
      <li class="h-full">
        <div
          class="project-card p-4 h-full relative border border-zinc-700 backdrop-blur-sm rounded-xl overflow-hidden group"
          data-spotlight
          style={`--project-rgb: ${project.color}; --project-background: ${project.background}`}
        >
          <div
            class="project-glow pointer-events-none absolute inset-0"
            aria-hidden="true"
          />
          {project.image && (
            <Image
              class="project-logo absolute right-3 top-3 z-10 rounded-full"
              width={32}
              height={32}
              src={project.image}
              alt={project.title}
            />
          )}
          <div class="relative z-10 flex flex-col gap-3 h-full">
            <h1 class="text-base leading-tight font-medium tracking-tight pr-10">
              {project.title}
            </h1>
            <p class="text-sm font-light text-pretty leading-relaxed text-neutral-400">
              {project.description}
            </p>
            <div class="card-actions justify-between items-center mt-auto pt-2">
              <div class="flex flex-col items-start gap-2 w-full">
                <div class="flex gap-3">
                  {project.githubUrl && (
                    <a
                      href={project.githubUrl}
                      target="_blank"
                      class="hover:text-white flex gap-1 items-center text-xs font-medium leading-relaxed text-neutral-400 transition-colors"
                    >
                      <Icon name="mdi:github" class="size-4" />
                      Github
                    </a>
                  )}
                  {project.siteUrl && (
                    <a
                      href={project.siteUrl}
                      target="_blank"
                      class="hover:text-white flex gap-1 items-center text-xs font-medium leading-relaxed text-neutral-400 transition-colors"
                    >
                      <Icon name="mdi:link" class="size-4" />
                      Website
                    </a>
                  )}
                </div>
                <div class="flex gap-1 flex-wrap">
                  {project.tags.map((tag) => (
                    <div class="bg-slate-800/50 px-1.5 py-0.5 text-xs text-neutral-400 rounded border border-slate-700">
                      {tag}
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </div>
      </li>
    ))
  }
</ul>

<style>
  .project-card {
    background-color: var(--project-background);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.025);
    transition: border-color 180ms ease;
  }

  .project-glow {
    background:
      radial-gradient(
        220px circle at var(--x, 50%) var(--y, 50%),
        rgb(var(--project-rgb) / 0.15),
        transparent 65%
      );
    opacity: 0.55;
    transition: opacity 180ms ease-out;
  }

  .project-logo {
    box-shadow:
      0 12px 32px rgb(0 0 0 / 0.25),
      0 0 28px rgb(var(--project-rgb) / 0.08);
    transition: transform 180ms ease-out;
  }

  .project-card:focus-within {
    border-color: rgb(82 82 91);
  }

  @media (hover: hover) and (pointer: fine) {
    .project-card:hover {
      border-color: rgb(82 82 91);
    }

    .project-card:hover .project-logo {
      transform: scale(1.04);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card,
    .project-logo,
    .project-glow {
      transform: none;
      transition: none;
    }
  }
</style>
