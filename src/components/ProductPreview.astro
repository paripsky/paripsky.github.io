---
import { Icon } from "astro-icon/components";
---

<dialog
  id="product-preview"
  aria-labelledby="product-preview-title"
  class="product-dialog m-auto border-0 bg-transparent p-0 text-white"
>
  <div
    class="preview-panel relative flex h-full flex-col items-center justify-center gap-5 overflow-hidden rounded-2xl bg-slate-950/95 p-5 sm:p-8"
  >
    <button
      type="button"
      data-preview-close
      aria-label="Close image preview"
      class="preview-close absolute right-4 top-4 z-20 rounded-full border border-zinc-700 bg-slate-900/90 p-2 text-neutral-400 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-300"
    >
      <Icon name="mdi:close" class="size-5" />
    </button>
    <img
      data-preview-image
      class="min-h-0 max-h-[72vh] w-full object-contain"
      alt=""
    />
    <p
      id="product-preview-title"
      data-preview-title
      class="shrink-0 text-sm font-medium text-neutral-300"
    >
    </p>
  </div>
</dialog>

<style>
  .product-dialog {
    --ease-out: cubic-bezier(0.23, 1, 0.32, 1);
    width: min(94vw, 1120px);
    height: min(88vh, 820px);
    max-width: none;
    max-height: none;
    transform-origin: center;
  }

  .product-dialog[open] {
    opacity: 1;
    transform: translateY(0) scale(1);
    transition:
      opacity 180ms var(--ease-out),
      transform 220ms var(--ease-out);
  }

  .product-dialog::backdrop {
    background: rgb(2 6 23 / 0.88);
    backdrop-filter: blur(12px);
  }

  .product-dialog[open]::backdrop {
    opacity: 1;
    transition: opacity 180ms var(--ease-out);
  }

  .preview-panel {
    box-shadow: 0 30px 100px rgb(0 0 0 / 0.55);
  }

  .preview-close {
    transition:
      color 140ms ease,
      transform 140ms var(--ease-out);
  }

  .preview-close:active {
    transform: scale(0.97);
  }

  @starting-style {
    .product-dialog[open] {
      opacity: 0;
      transform: translateY(12px) scale(0.965);
    }

    .product-dialog[open]::backdrop {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .product-dialog[open] {
      transform: none;
      transition: opacity 140ms ease-out;
    }

    .product-dialog[open]::backdrop {
      transition: opacity 140ms ease-out;
    }

    @starting-style {
      .product-dialog[open] {
        opacity: 0;
        transform: none;
      }
    }
  }
</style>

<style is:global>
  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation: none;
    mix-blend-mode: normal;
  }

  ::view-transition-group(product-preview-image) {
    z-index: 2147483647;
    animation-duration: 260ms;
    animation-timing-function: cubic-bezier(0.77, 0, 0.175, 1);
  }

  ::view-transition-old(product-preview-image),
  ::view-transition-new(product-preview-image) {
    animation: none;
    height: 100%;
    mix-blend-mode: normal;
    object-fit: contain;
  }

  @media (prefers-reduced-motion: reduce) {
    ::view-transition-group(product-preview-image) {
      animation: none;
    }
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const dialog = document.querySelector<HTMLDialogElement>("#product-preview");
    const previewImage = dialog?.querySelector<HTMLImageElement>("[data-preview-image]");
    const previewTitle = dialog?.querySelector<HTMLElement>("[data-preview-title]");

    if (dialog && previewImage && previewTitle && !dialog.dataset.previewReady) {
      dialog.dataset.previewReady = "true";
      let previewRequest = 0;
      let transitionRun = 0;
      let activeSource: HTMLImageElement | null = null;

      const transitionDocument = document as Document & {
        startViewTransition?: (update: () => void) => { finished: Promise<void> };
      };
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

      const closePreview = () => {
        if (!dialog.open) return;

        const source = activeSource;
        if (!source?.isConnected || !transitionDocument.startViewTransition || reduceMotion.matches) {
          transitionRun++;
          dialog.close();
          activeSource = null;
          return;
        }

        const run = ++transitionRun;
        previewImage.style.viewTransitionName = "product-preview-image";
        const transition = transitionDocument.startViewTransition(() => {
          previewImage.style.viewTransitionName = "";
          source.style.viewTransitionName = "product-preview-image";
          dialog.close();
        });
        const clearTransitionNames = () => {
          if (run !== transitionRun) return;
          source.style.viewTransitionName = "";
          previewImage.style.viewTransitionName = "";
          activeSource = null;
        };

        transition.finished.then(clearTransitionNames, clearTransitionNames);
      };

      document.querySelectorAll<HTMLButtonElement>("[data-product-preview]").forEach((button) => {
        button.addEventListener("click", async () => {
          const source = button.querySelector<HTMLImageElement>("img");
          if (!source) return;

          const sources = source.srcset
            .split(",")
            .map((candidate) => candidate.trim().split(/\s+/)[0])
            .filter(Boolean);

          const nextSource = sources.at(-1) ?? source.currentSrc ?? source.src;
          const request = ++previewRequest;
          const nextImage = new Image();
          nextImage.src = nextSource;

          try {
            await nextImage.decode();
          } catch {
            if (!nextImage.complete) return;
          }

          if (request !== previewRequest) return;
          activeSource = source;

          const openPreview = () => {
            previewImage.src = nextSource;
            previewImage.alt = source.alt;
            previewTitle.textContent = source.alt;
            dialog.showModal();
          };

          if (!transitionDocument.startViewTransition || reduceMotion.matches) {
            openPreview();
            return;
          }

          const run = ++transitionRun;
          source.style.viewTransitionName = "product-preview-image";
          const transition = transitionDocument.startViewTransition(() => {
            source.style.viewTransitionName = "";
            previewImage.style.viewTransitionName = "product-preview-image";
            openPreview();
          });
          const clearTransitionNames = () => {
            if (run !== transitionRun) return;
            source.style.viewTransitionName = "";
            previewImage.style.viewTransitionName = "";
          };

          transition.finished.then(clearTransitionNames, clearTransitionNames);
        });
      });

      dialog.querySelector<HTMLButtonElement>("[data-preview-close]")?.addEventListener("click", () => {
        closePreview();
      });

      dialog.addEventListener("click", (event) => {
        if (event.target === dialog) closePreview();
      });

      dialog.addEventListener("cancel", (event) => {
        event.preventDefault();
        closePreview();
      });

      dialog.addEventListener("close", () => {
        previewRequest++;
        previewImage.style.viewTransitionName = "";
        previewImage.removeAttribute("src");
        previewImage.alt = "";
        previewTitle.textContent = "";
      });
    }

    if (
      !window.matchMedia("(pointer: fine)").matches ||
      window.matchMedia("(prefers-reduced-motion: reduce)").matches
    )
      return;

    document.querySelectorAll<HTMLElement>("[data-product-tilt]").forEach((element) => {
      if (element.dataset.tiltReady) return;
      element.dataset.tiltReady = "true";
      let frame = 0;

      element.addEventListener("pointermove", (event) => {
        cancelAnimationFrame(frame);
        frame = requestAnimationFrame(() => {
          const rect = element.getBoundingClientRect();
          const x = (event.clientX - rect.left) / rect.width;
          const y = (event.clientY - rect.top) / rect.height;
          const maxTilt = Number(element.dataset.maxTilt ?? 3);

          element.style.setProperty("--tilt-x", `${(0.5 - y) * maxTilt * 2}deg`);
          element.style.setProperty("--tilt-y", `${(x - 0.5) * maxTilt * 2}deg`);
          element.style.setProperty("--shadow-x", `${(0.5 - x) * 14}px`);
        });
      });

      element.addEventListener("pointerleave", () => {
        cancelAnimationFrame(frame);
        element.style.setProperty("--tilt-x", "0deg");
        element.style.setProperty("--tilt-y", "0deg");
        element.style.setProperty("--shadow-x", "0px");
      });
    });
  });
</script>
