---
import { Icon } from "astro-icon/components";
---

<dialog
  id="product-preview"
  aria-labelledby="product-preview-title"
  class="product-dialog m-auto border-0 bg-transparent p-0 text-white"
>
  <div
    class="preview-panel relative flex h-full flex-col items-center justify-center gap-5 overflow-hidden rounded-2xl bg-slate-950/95 p-5 sm:p-8"
  >
    <button
      type="button"
      data-preview-close
      aria-label="Close image preview"
      class="preview-close absolute right-4 top-4 z-20 rounded-full border border-zinc-700 bg-slate-900/90 p-2 text-neutral-400 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-300"
    >
      <Icon name="mdi:close" class="size-5" />
    </button>
    <img
      data-preview-image
      class="min-h-0 max-h-[72vh] w-full object-contain"
      alt=""
    />
    <p
      id="product-preview-title"
      data-preview-title
      class="shrink-0 text-sm font-medium text-neutral-300"
    >
    </p>
  </div>
</dialog>

<style>
  .product-dialog {
    --ease-out: cubic-bezier(0.23, 1, 0.32, 1);
    width: min(94vw, 1120px);
    height: min(88vh, 820px);
    max-width: none;
    max-height: none;
    opacity: 0;
    transform: translateY(10px) scale(0.98);
    transform-origin: center;
    transition:
      opacity 160ms var(--ease-out),
      transform 200ms var(--ease-out);
  }

  .product-dialog[open] {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  .product-dialog::backdrop {
    background: rgb(2 6 23 / 0.88);
    backdrop-filter: blur(12px);
    opacity: 0;
    transition: opacity 160ms var(--ease-out);
  }

  .product-dialog[open]::backdrop {
    opacity: 1;
  }

  .product-dialog[open].is-opening,
  .product-dialog[open].is-closing {
    opacity: 0;
    transform: translateY(8px) scale(0.985);
  }

  .product-dialog[open].is-opening::backdrop,
  .product-dialog[open].is-closing::backdrop {
    opacity: 0;
  }

  .product-dialog.is-closing {
    pointer-events: none;
  }

  .preview-panel {
    box-shadow: 0 30px 100px rgb(0 0 0 / 0.55);
  }

  .preview-close {
    transition:
      color 140ms ease,
      transform 140ms var(--ease-out);
  }

  .preview-close:active {
    transform: scale(0.97);
  }

  @media (prefers-reduced-motion: reduce) {
    .product-dialog,
    .product-dialog[open] {
      transform: none;
      transition: opacity 140ms ease-out;
    }

    .product-dialog::backdrop {
      transition: opacity 140ms ease-out;
    }

    .product-dialog[open].is-opening,
    .product-dialog[open].is-closing {
      transform: none;
    }
  }
</style>

<style is:global>
  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation: none;
    mix-blend-mode: normal;
  }

  ::view-transition-group(product-preview-image) {
    z-index: 2147483647;
    animation-duration: 260ms;
    animation-timing-function: cubic-bezier(0.77, 0, 0.175, 1);
  }

  ::view-transition-old(product-preview-image),
  ::view-transition-new(product-preview-image) {
    animation: none;
    height: 100%;
    mix-blend-mode: normal;
    object-fit: contain;
  }

  @media (prefers-reduced-motion: reduce) {
    ::view-transition-group(product-preview-image) {
      animation: none;
    }
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const dialog = document.querySelector<HTMLDialogElement>("#product-preview");
    const previewImage = dialog?.querySelector<HTMLImageElement>("[data-preview-image]");
    const previewTitle = dialog?.querySelector<HTMLElement>("[data-preview-title]");

    if (dialog && previewImage && previewTitle && !dialog.dataset.previewReady) {
      dialog.dataset.previewReady = "true";
      let previewRequest = 0;
      let transitionRun = 0;
      let activeSource: HTMLImageElement | null = null;
      let activePreviewIndex: number | null = null;
      let closing = false;
      const previewStateKey = "productPreviewIndex";
      const previewButtons = Array.from(
        document.querySelectorAll<HTMLButtonElement>("[data-product-preview]"),
      );

      const transitionDocument = document as Document & {
        startViewTransition?: (update: () => void) => { finished: Promise<void> };
      };
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
      const precisePointer = window.matchMedia("(hover: hover) and (pointer: fine)");
      const compactViewport = window.matchMedia("(max-width: 767px)");

      const canUseSharedTransition = () =>
        Boolean(
          transitionDocument.startViewTransition &&
            precisePointer.matches &&
            !compactViewport.matches &&
            !reduceMotion.matches,
        );

      const finishDialogClose = () => {
        dialog.classList.remove("is-opening", "is-closing");
        delete document.documentElement.dataset.productPreviewOpen;
        dialog.close();
        activeSource = null;
        activePreviewIndex = null;
        closing = false;
      };

      const closePreview = () => {
        if (!dialog.open || closing) return;

        closing = true;
        delete document.documentElement.dataset.productPreviewOpen;
        previewRequest++;
        const source = activeSource;
        if (!source?.isConnected || !canUseSharedTransition()) {
          transitionRun++;
          dialog.classList.remove("is-opening");
          dialog.classList.add("is-closing");
          window.setTimeout(finishDialogClose, reduceMotion.matches ? 140 : 200);
          return;
        }

        const run = ++transitionRun;
        previewImage.style.viewTransitionName = "product-preview-image";
        const transition = transitionDocument.startViewTransition(() => {
          previewImage.style.viewTransitionName = "";
          source.style.viewTransitionName = "product-preview-image";
          finishDialogClose();
        });
        const clearTransitionNames = () => {
          if (run !== transitionRun) return;
          source.style.viewTransitionName = "";
          previewImage.style.viewTransitionName = "";
          activeSource = null;
        };

        transition.finished.then(clearTransitionNames, clearTransitionNames);
      };

      const requestPreviewClose = () => {
        if (!dialog.open || closing) return;

        if (history.state?.[previewStateKey] === activePreviewIndex) {
          history.back();
          return;
        }

        closePreview();
      };

      const openPreviewForButton = async (
        button: HTMLButtonElement,
        index: number,
        addHistoryEntry: boolean,
      ) => {
        const source = button.querySelector<HTMLImageElement>("img");
        if (!source) return;

        const immediateSource = source.currentSrc || source.src;
        const sources = source.srcset
          .split(",")
          .map((candidate) => candidate.trim().split(/\s+/)[0])
          .filter(Boolean);

        const nextSource = sources.at(-1) ?? immediateSource;
        const request = ++previewRequest;
        closing = false;
        activeSource = source;
        activePreviewIndex = index;

        const openPreview = () => {
          previewImage.src = immediateSource;
          previewImage.alt = source.alt;
          previewTitle.textContent = source.alt;
          document.documentElement.dataset.productPreviewOpen = "true";
          dialog.showModal();

          if (addHistoryEntry) {
            const currentState =
              history.state && typeof history.state === "object" ? history.state : {};
            history.pushState(
              { ...currentState, [previewStateKey]: index },
              "",
              location.href,
            );
          }
        };

        let transitionFinished = Promise.resolve();

        if (!canUseSharedTransition()) {
          dialog.classList.add("is-opening");
          openPreview();
          requestAnimationFrame(() => {
            requestAnimationFrame(() => dialog.classList.remove("is-opening"));
          });
        } else {
          const run = ++transitionRun;
          source.style.viewTransitionName = "product-preview-image";
          const transition = transitionDocument.startViewTransition(() => {
            source.style.viewTransitionName = "";
            previewImage.style.viewTransitionName = "product-preview-image";
            openPreview();
          });
          const clearTransitionNames = () => {
            if (run !== transitionRun) return;
            source.style.viewTransitionName = "";
            previewImage.style.viewTransitionName = "";
          };

          transitionFinished = transition.finished.then(clearTransitionNames, clearTransitionNames);
        }

        if (nextSource === immediateSource) return;

        const nextImage = new Image();
        nextImage.src = nextSource;

        try {
          await Promise.all([nextImage.decode(), transitionFinished]);
        } catch {
          if (!nextImage.complete) return;
          await transitionFinished;
        }

        if (request !== previewRequest || !dialog.open || activeSource !== source) return;
        previewImage.src = nextSource;
      };

      previewButtons.forEach((button, index) => {
        button.addEventListener("click", () => {
          void openPreviewForButton(button, index, true);
        });
      });

      const handleHistoryTraversal = (event: Event) => {
        const state = (event as CustomEvent).detail;
        const nextPreviewIndex = state?.[previewStateKey];

        if (dialog.open) {
          if (nextPreviewIndex !== activePreviewIndex) closePreview();
          return;
        }

        if (typeof nextPreviewIndex !== "number") return;
        const button = previewButtons[nextPreviewIndex];
        if (button) void openPreviewForButton(button, nextPreviewIndex, false);
      };

      window.addEventListener("product-preview-history", handleHistoryTraversal);
      document.addEventListener(
        "astro:before-swap",
        () => window.removeEventListener("product-preview-history", handleHistoryTraversal),
        { once: true },
      );

      dialog.querySelector<HTMLButtonElement>("[data-preview-close]")?.addEventListener("click", () => {
        requestPreviewClose();
      });

      dialog.addEventListener("click", (event) => {
        if (event.target === dialog) requestPreviewClose();
      });

      dialog.addEventListener("cancel", (event) => {
        event.preventDefault();
        requestPreviewClose();
      });

      dialog.addEventListener("close", () => {
        previewRequest++;
        previewImage.style.viewTransitionName = "";
        previewImage.removeAttribute("src");
        previewImage.alt = "";
        previewTitle.textContent = "";
      });
    }

    if (
      !window.matchMedia("(pointer: fine)").matches ||
      window.matchMedia("(prefers-reduced-motion: reduce)").matches
    )
      return;

    document.querySelectorAll<HTMLElement>("[data-product-tilt]").forEach((element) => {
      if (element.dataset.tiltReady) return;
      element.dataset.tiltReady = "true";
      let frame = 0;

      element.addEventListener("pointermove", (event) => {
        cancelAnimationFrame(frame);
        frame = requestAnimationFrame(() => {
          const rect = element.getBoundingClientRect();
          const x = (event.clientX - rect.left) / rect.width;
          const y = (event.clientY - rect.top) / rect.height;
          const maxTilt = Number(element.dataset.maxTilt ?? 3);

          element.style.setProperty("--tilt-x", `${(0.5 - y) * maxTilt * 2}deg`);
          element.style.setProperty("--tilt-y", `${(x - 0.5) * maxTilt * 2}deg`);
          element.style.setProperty("--shadow-x", `${(0.5 - x) * 14}px`);
        });
      });

      element.addEventListener("pointerleave", () => {
        cancelAnimationFrame(frame);
        element.style.setProperty("--tilt-x", "0deg");
        element.style.setProperty("--tilt-y", "0deg");
        element.style.setProperty("--shadow-x", "0px");
      });
    });
  });
</script>
