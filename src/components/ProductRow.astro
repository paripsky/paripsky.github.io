---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { Icon } from "astro-icon/components";

export type Product = {
  name: string;
  href: string;
  image: ImageMetadata;
  alt: string;
  note: string;
  attributes: string[];
  previewWidths: number[];
};

type Props = {
  product: Product;
  featured?: boolean;
};

const { product, featured = false } = Astro.props;
---

<li data-product-tilt data-max-tilt="2">
  <article
    class:list={[
      "grid min-h-40 grid-cols-[minmax(0,1fr)_7rem] items-center gap-4 py-6",
      featured
        ? "sm:grid-cols-[minmax(0,1fr)_11rem]"
        : "sm:grid-cols-[minmax(0,1fr)_10rem]",
    ]}
  >
    <div class="flex min-w-0 flex-col gap-3">
      <a
        href={product.href}
        target="_blank"
        rel="noreferrer"
        class="group/link flex w-fit items-start gap-2"
      >
        <h4
          class="text-base font-medium tracking-tight text-neutral-100 transition-colors group-hover/link:text-white"
        >
          {product.name}
        </h4>
        <Icon
          name="mdi:arrow-top-right"
          class="mt-0.5 size-3.5 shrink-0 text-neutral-600 transition group-hover/link:-translate-y-0.5 group-hover/link:translate-x-0.5 group-hover/link:text-sky-300"
        />
      </a>
      <p class="text-sm font-light leading-relaxed text-neutral-400">
        {product.note}
      </p>
      <ul class="hidden flex-wrap gap-1.5 sm:flex">
        {
          product.attributes.map((attribute) => (
            <li class="rounded border border-slate-700 bg-slate-800/50 px-1.5 py-0.5 text-xs text-neutral-400">
              {attribute}
            </li>
          ))
        }
      </ul>
    </div>
    <button
      type="button"
      data-product-preview
      aria-haspopup="dialog"
      aria-label={`View a larger image of ${product.name}`}
      class:list={[
        "product-image group/image relative flex cursor-zoom-in items-center justify-center rounded-lg focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-sky-300",
        featured ? "h-28 sm:h-36" : "h-28 sm:h-32",
      ]}
    >
      <div class="product-shadow absolute bottom-4 h-5 w-4/5 rounded-full"></div>
      <Image
        src={product.image}
        alt={product.alt}
        widths={product.previewWidths}
        sizes={featured ? "(min-width: 640px) 176px, 112px" : "(min-width: 640px) 160px, 112px"}
        format="webp"
        loading="lazy"
        decoding="async"
        data-product-image
        class="relative z-10 max-h-full w-full object-contain"
      />
      <span
        class="absolute right-0 top-0 z-20 rounded-full border border-zinc-700 bg-slate-950/80 p-1.5 text-neutral-500 opacity-0 transition group-hover/image:text-sky-300 group-hover/image:opacity-100 group-focus-visible/image:opacity-100"
      >
        <Icon name="mdi:magnify-plus-outline" class="size-3.5" />
      </span>
    </button>
  </article>
</li>

<style>
  .product-image {
    --ease-out: cubic-bezier(0.23, 1, 0.32, 1);
    transition: transform 140ms var(--ease-out);
  }

  .product-image:active {
    transform: scale(0.97);
  }

  [data-product-tilt] {
    --tilt-x: 0deg;
    --tilt-y: 0deg;
    --shadow-x: 0px;
    transform: perspective(1000px) rotateX(var(--tilt-x)) rotateY(var(--tilt-y));
    transform-style: preserve-3d;
    transition: transform 180ms ease-out;
    will-change: transform;
  }

  [data-product-image] {
    transform: translate3d(0, 0, 24px);
    filter: drop-shadow(0 18px 18px rgb(0 0 0 / 0.25));
    transition:
      filter 180ms ease-out,
      transform 180ms ease-out;
  }

  .product-shadow {
    background: rgb(0 0 0 / 0.5);
    filter: blur(16px);
    transform: translate3d(var(--shadow-x), 0, 2px);
    transition: transform 180ms ease-out;
  }

  @media (hover: hover) and (pointer: fine) {
    .product-image:hover [data-product-image] {
      transform: translate3d(0, 0, 28px) scale(1.04);
      filter: drop-shadow(0 22px 22px rgb(0 0 0 / 0.38));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .product-image,
    [data-product-tilt],
    [data-product-image],
    .product-shadow {
      transform: none;
      transition: none;
    }
  }
</style>
