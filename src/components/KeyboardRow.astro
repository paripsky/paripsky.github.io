---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { Icon } from "astro-icon/components";

type Keyboard = {
  name: string;
  href: string;
  image: ImageMetadata;
  alt: string;
  note: string;
  attributes: string[];
  previewWidths: number[];
  currentLabel?: string;
};

type Props = {
  keyboard: Keyboard;
  current?: boolean;
};

const { keyboard, current = false } = Astro.props;
---

<li data-product-tilt data-max-tilt="2">
  <article
    class:list={[
      "grid min-h-40 grid-cols-[minmax(0,1fr)_7rem] items-center gap-4 py-6",
      current
        ? "sm:grid-cols-[minmax(0,1fr)_11rem]"
        : "sm:grid-cols-[minmax(0,1fr)_10rem]",
    ]}
  >
    <div class="flex min-w-0 flex-col gap-3">
      {
        keyboard.currentLabel && (
          <span class="font-mono text-[0.68rem] uppercase tracking-[0.18em] text-sky-300">
            {keyboard.currentLabel}
          </span>
        )
      }
      <a
        href={keyboard.href}
        target="_blank"
        rel="noreferrer"
        class="group/link flex w-fit items-start gap-2"
      >
        <h4
          class="text-base font-medium tracking-tight text-neutral-200 transition-colors group-hover/link:text-white"
        >
          {keyboard.name}
        </h4>
        <Icon
          name="mdi:arrow-top-right"
          class="mt-0.5 size-3.5 shrink-0 text-neutral-600 transition group-hover/link:-translate-y-0.5 group-hover/link:translate-x-0.5 group-hover/link:text-sky-300"
        />
      </a>
      <p class="text-xs font-light leading-relaxed text-neutral-500 sm:text-sm">
        {keyboard.note}
      </p>
      <ul class="hidden flex-wrap gap-x-3 gap-y-1 sm:flex">
        {
          keyboard.attributes.map((attribute) => (
            <li class="text-[0.68rem] uppercase tracking-wider text-neutral-600">
              {attribute}
            </li>
          ))
        }
      </ul>
    </div>
    <button
      type="button"
      data-keyboard-preview
      aria-haspopup="dialog"
      aria-label={`View a larger image of ${keyboard.name}`}
      class:list={[
        "keyboard-image group/image relative flex cursor-zoom-in items-center justify-center rounded-lg focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-sky-300",
        current ? "h-28 sm:h-36" : "h-28 sm:h-32",
      ]}
    >
      <div class="product-shadow absolute bottom-4 h-5 w-4/5 rounded-full"></div>
      <Image
        src={keyboard.image}
        alt={keyboard.alt}
        widths={keyboard.previewWidths}
        sizes={current ? "(min-width: 640px) 176px, 112px" : "(min-width: 640px) 160px, 112px"}
        format="webp"
        loading="lazy"
        decoding="async"
        data-product-image
        class="relative z-10 max-h-full w-full object-contain"
      />
      <span
        class="absolute right-0 top-0 z-20 rounded-full border border-zinc-700 bg-slate-950/80 p-1.5 text-neutral-500 opacity-0 transition group-hover/image:text-sky-300 group-hover/image:opacity-100 group-focus-visible/image:opacity-100"
      >
        <Icon name="mdi:magnify-plus-outline" class="size-3.5" />
      </span>
    </button>
  </article>
</li>

<style>
  [data-product-tilt] {
    --tilt-x: 0deg;
    --tilt-y: 0deg;
    --shadow-x: 0px;
    transform: perspective(1000px) rotateX(var(--tilt-x)) rotateY(var(--tilt-y));
    transform-style: preserve-3d;
    transition: transform 180ms ease-out;
    will-change: transform;
  }

  [data-product-image] {
    transform: translate3d(0, 0, 24px);
    filter: drop-shadow(0 18px 18px rgb(0 0 0 / 0.25));
    transition:
      filter 180ms ease-out,
      transform 180ms ease-out;
  }

  .keyboard-image:hover [data-product-image] {
    transform: translate3d(0, 0, 28px) scale(1.04);
    filter: drop-shadow(0 22px 22px rgb(0 0 0 / 0.38));
  }

  .product-shadow {
    background: rgb(0 0 0 / 0.5);
    filter: blur(16px);
    transform: translate3d(var(--shadow-x), 0, 2px);
    transition: transform 180ms ease-out;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-product-tilt],
    [data-product-image],
    .product-shadow {
      transform: none;
      transition: none;
    }
  }
</style>
