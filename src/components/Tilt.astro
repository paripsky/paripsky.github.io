---
const id = crypto.randomUUID();
---

<div id={id} class="tilt bg-zinc-800 border border-zinc-700 rounded-lg p-4">
  <slot />
</div>

<style>
  .tilt {
    --rotateX: 0deg;
    --rotateY: 0deg;
    transform-style: preserve-3d;
  }

  @media (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .tilt {
      transform: perspective(300px) rotateY(var(--rotateX))
        rotateX(var(--rotateY));
    }

    .tilt::before,
    .tilt::after {
      content: "";
      position: absolute;
      border-radius: inherit;
    }

    .tilt::after {
      z-index: -2;
      inset: -1rem;
      /* background: linear-gradient(-45deg, #8300a3, rgb(1, 79, 81)); */
      transform: translateZ(-10px);
      border-radius: 8px;
    }
  }
</style>

<script type="module" is:inline>
  document.addEventListener("astro:page-load", () => {
    if (
      !window.matchMedia("(pointer: fine)").matches ||
      window.matchMedia("(prefers-reduced-motion: reduce)").matches
    )
      return;

    const tiltElements = document.querySelectorAll(".tilt");

    tiltElements.forEach((element) => {
      if (!(element instanceof HTMLElement) || element.dataset.tiltReady) return;
      element.dataset.tiltReady = "true";
      const controller = new AbortController();

      document.addEventListener(
        "mousemove",
        (event) => {
          const middleX = window.innerWidth / 2;
          const middleY = window.innerHeight / 2;
          const offsetX = ((event.clientX - middleX) / middleX) * 15;
          const offsetY = ((event.clientY - middleY) / middleY) * 15;

          element.style.setProperty("--rotateX", `${offsetX}deg`);
          element.style.setProperty("--rotateY", `${-offsetY}deg`);
        },
        { signal: controller.signal },
      );

      document.addEventListener(
        "astro:before-swap",
        () => {
          controller.abort();
        },
        { once: true },
      );
    });
  });
</script>
