---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import codexLogo from "../assets/software/codex.png";
import obsidianLogo from "../assets/software/obsidian.png";
import zedLogo from "../assets/software/zed.png";
import heliumLogo from "../assets/software/helium.png";
import raycastLogo from "../assets/software/raycast.png";
import sublimeMergeLogo from "../assets/software/sublime-merge.png";

type Tool = {
  name: string;
  href: string;
  logo: ImageMetadata;
  logoAlt: string;
  rounded?: boolean;
};

const tools: Tool[] = [
  {
    name: "Codex",
    href: "https://openai.com/codex/",
    logo: codexLogo,
    logoAlt: "Codex logo",
  },
  {
    name: "Obsidian",
    href: "https://obsidian.md/",
    logo: obsidianLogo,
    logoAlt: "Obsidian logo",
  },
  {
    name: "Zed",
    href: "https://zed.dev/",
    logo: zedLogo,
    logoAlt: "Zed logo",
  },
  {
    name: "Helium",
    href: "https://helium.computer/",
    logo: heliumLogo,
    logoAlt: "Helium logo",
  },
  {
    name: "Raycast",
    href: "https://www.raycast.com/",
    logo: raycastLogo,
    logoAlt: "Raycast logo",
  },
  {
    name: "Sublime Merge",
    href: "https://www.sublimemerge.com/",
    logo: sublimeMergeLogo,
    logoAlt: "Sublime Merge logo",
    rounded: true,
  },
];
---

<div class="software-gallery">
  <ul class="software-grid" role="list">
    {
      tools.map((tool) => (
        <li>
          <a
            href={tool.href}
            target="_blank"
            rel="noreferrer"
            class="software-link flex flex-col items-center gap-3 rounded-sm p-3 text-center text-sm font-medium tracking-tight text-neutral-300 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-sky-300"
          >
            <Image
              src={tool.logo}
              alt={tool.logoAlt}
              widths={[64, 128]}
              sizes="64px"
              format="webp"
              loading="lazy"
              decoding="async"
              class:list={[
                "size-16 object-contain",
                tool.rounded && "rounded-[30%]",
              ]}
            />
            <span>{tool.name}</span>
          </a>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .software-gallery {
    container-type: inline-size;
  }

  .software-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .software-link {
    transition: color 150ms ease;
  }

  @container (min-width: 28rem) {
    .software-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .software-link {
      transition: none;
    }
  }
</style>
