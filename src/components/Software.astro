---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { Icon } from "astro-icon/components";
import codexLogo from "../assets/software/codex.png";
import obsidianLogo from "../assets/software/obsidian.png";
import zedLogo from "../assets/software/zed.png";
import heliumLogo from "../assets/software/helium.png";
import raycastLogo from "../assets/software/raycast.png";
import sublimeMergeLogo from "../assets/software/sublime-merge.png";

type Tool = {
  name: string;
  href: string;
  logo: ImageMetadata;
  logoAlt: string;
  purpose: string;
  color: string;
  rounded?: boolean;
};

const tools: Tool[] = [
  {
    name: "Codex",
    href: "https://openai.com/codex/",
    logo: codexLogo,
    logoAlt: "Codex logo",
    purpose: "Delegating coding work",
    color: "86 101 255",
  },
  {
    name: "Obsidian",
    href: "https://obsidian.md/",
    logo: obsidianLogo,
    logoAlt: "Obsidian logo",
    purpose: "Notes and connected ideas",
    color: "139 92 246",
  },
  {
    name: "Zed",
    href: "https://zed.dev/",
    logo: zedLogo,
    logoAlt: "Zed logo",
    purpose: "Reading and editing code",
    color: "212 212 216",
  },
  {
    name: "Helium",
    href: "https://helium.computer/",
    logo: heliumLogo,
    logoAlt: "Helium logo",
    purpose: "Browsing and checking the result",
    color: "96 132 255",
  },
  {
    name: "Raycast",
    href: "https://www.raycast.com/",
    logo: raycastLogo,
    logoAlt: "Raycast logo",
    purpose: "Launching apps and automating shortcuts",
    color: "255 99 111",
  },
  {
    name: "Sublime Merge",
    href: "https://www.sublimemerge.com/",
    logo: sublimeMergeLogo,
    logoAlt: "Sublime Merge logo",
    purpose: "Reviewing Git history and changes",
    color: "42 211 215",
    rounded: true,
  },
];
---

<div class="@container">
  <ul class="grid grid-cols-1 gap-3 @md:grid-cols-2">
    {
      tools.map((tool) => (
        <li>
          <a
            href={tool.href}
            target="_blank"
            rel="noreferrer"
            data-spotlight
            style={`--tool-rgb: ${tool.color}`}
            class="software-card group relative flex min-h-36 items-center gap-4 overflow-hidden rounded-xl border border-zinc-700 bg-slate-900/20 p-4 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-sky-300"
          >
            <div class="software-glow pointer-events-none absolute inset-0" />
            <div class="software-logo relative z-10 flex size-16 shrink-0 items-center justify-center rounded-2xl border border-white/10 bg-slate-950/70 p-1.5">
              <Image
                src={tool.logo}
                alt={tool.logoAlt}
                widths={[64, 128]}
                sizes="64px"
                format="webp"
                loading="lazy"
                decoding="async"
                class:list={[
                  "size-full object-contain",
                  tool.rounded && "rounded-[30%]",
                ]}
              />
            </div>
            <div class="relative z-10 flex min-w-0 flex-1 flex-col gap-1.5">
              <span class="text-base font-medium tracking-tight text-neutral-100">
                {tool.name}
              </span>
              <span class="text-sm font-light leading-relaxed text-neutral-400">
                {tool.purpose}
              </span>
            </div>
            <Icon
              name="mdi:arrow-top-right"
              class="relative z-10 size-3.5 shrink-0 self-start text-neutral-600 transition group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-sky-300"
            />
          </a>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .software-card {
    --tool-rgb: 125 211 252;
    --ease-out: cubic-bezier(0.23, 1, 0.32, 1);
    transform: translateY(0);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.025);
    transition:
      border-color 180ms ease,
      transform 140ms var(--ease-out);
  }

  .software-card:active {
    transform: scale(0.98);
  }

  .software-glow {
    background:
      radial-gradient(
        220px circle at var(--x) var(--y),
        rgb(var(--tool-rgb) / 0.15),
        transparent 65%
      ),
      linear-gradient(135deg, rgb(var(--tool-rgb) / 0.07), transparent 50%);
    opacity: 0.55;
    transition: opacity 180ms ease-out;
  }

  .software-logo {
    box-shadow:
      0 12px 32px rgb(0 0 0 / 0.25),
      0 0 28px rgb(var(--tool-rgb) / 0.08);
    transition: transform 180ms ease-out;
  }

  @media (hover: hover) and (pointer: fine) {
    .software-card:hover {
      transform: translateY(-2px);
      border-color: rgb(82 82 91);
    }

    .software-card:hover:active {
      transform: translateY(-2px) scale(0.98);
    }

    .software-card:hover .software-logo {
      transform: scale(1.04);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .software-card,
    .software-logo {
      transform: none;
      transition: none;
    }
  }
</style>
