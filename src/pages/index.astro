---
import Layout from "../layouts/Layout.astro";
import Logos from "../components/Logos.astro";
import Timeline from "../components/Timeline.astro";
import MyWork from "../components/MyWork.astro";
import DesktopDestroyer from "../components/DesktopDestroyer.astro";
import Tilt from "../components/Tilt.astro";
import Pill from "../components/Pill.astro";
import { Icon } from "astro-icon/components";
import Post from "../components/Post.astro";
import Presentations from "../components/Presentations.astro";
import Podcasts from "../components/Podcasts.astro";
import GearGallery from "../components/GearGallery.astro";
import Software from "../components/Software.astro";
import ProductPreview from "../components/ProductPreview.astro";

type Mention = {
  title: string;
  url: string;
};

const postsGlob = await import.meta.glob("./blog/*", { eager: true });
const posts = Object.values(postsGlob)
  .map(
    (p: {
      url: string;
      frontmatter: {
        title: string;
        description: string;
        date: string;
        tags: string[];
        mentions: Mention[];
      };
    }) => ({
      url: p.url,
      title: p.frontmatter.title,
      description: p.frontmatter.description,
      date: p.frontmatter.date,
      tags: p.frontmatter.tags,
      mentions: p.frontmatter.mentions ?? [],
    }),
  )
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

const navigationItems = [
  { href: "#posts", label: "Posts" },
  { href: "#podcasts", label: "Podcasts" },
  { href: "#presentations", label: "Presentations" },
  { href: "#projects", label: "Projects" },
  { href: "#timeline", label: "Experience" },
  { href: "#setup", label: "Gear" },
  { href: "#software", label: "Software" },
];
---

<Layout title="Jonathan Paripsky | Senior Software Engineer">
  <div class="-z-10 absolute inset-0 overflow-hidden h-full">
    <div
      class="relative h-screen w-full bg-slate-950 [&>div]:absolute [&>div]:bottom-0 [&>div]:right-[-20%] [&>div]:top-[-10%] [&>div]:h-[500px] [&>div]:w-[500px] [&>div]:rounded-full [&>div]:bg-[radial-gradient(circle_farthest-side,rgba(0,229,225,.15),rgba(255,255,255,0))]"
    >
      <div></div>
    </div>
  </div>
  <main
    class="w-full max-w-6xl mx-auto px-6 tracking-wide transition-all grid grid-cols-1 md:grid-cols-2 gap-12"
  >
    <div
      class="md:sticky md:top-0 md:h-screen flex flex-col justify-center py-12"
    >
      <section class="flex flex-col gap-6 mt-40 md:mt-0">
        <h1
          class="text-[clamp(2.5rem,5vw,4rem)] leading-tight font-medium tracking-tight motion-preset-slide-up motion-preset-fade-lg"
        >
          Hi, I'm Jonathan.
        </h1>
        <h2
          class="text-lg font-light text-pretty leading-relaxed text-neutral-300 motion-preset-slide-up motion-preset-fade-lg motion-reduce:motion-delay-0 motion-delay-300"
        >
          JavaScript Enthusiast, Software Engineer, and Occasional Post Writer.
        </h2>
        <div
          class="flex motion-preset-slide-up motion-preset-fade-lg motion-reduce:motion-delay-0 motion-delay-500"
        >
          <Tilt>
            <div class="flex gap-4">
              <Logos />
            </div>
          </Tilt>
        </div>
        <span
          class="text-sm font-light text-pretty leading-relaxed text-neutral-400 motion-preset-slide-up motion-preset-fade-lg motion-reduce:motion-delay-0 motion-delay-700"
          >Follow me on <a
            class="underline hover:text-white transition-colors"
            href="https://github.com/paripsky"
            target="_blank">Github</a
          > & <a
            class="underline hover:text-white transition-colors"
            href="https://www.linkedin.com/in/paripsky"
            target="_blank">Linkedin</a
          >.</span
        >

        <nav
          data-section-navigation
          aria-label="Page sections"
          class="hidden md:flex flex-col gap-2 mt-12 text-sm text-neutral-400"
        >
          {
            navigationItems.map((item) => (
              <a
                href={item.href}
                data-section-link
                data-label={item.label}
                class="section-link w-fit focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-sky-300"
              >
                {item.label}
              </a>
            ))
          }
        </nav>
      </section>
    </div>

    <div class="flex flex-col gap-20 py-12">
      <section id="posts" class="flex flex-col gap-6">
        <Pill><Icon name="mdi:post" class="size-4" /> Posts</Pill>
        <ul class="flex flex-col gap-4">
          {posts.map((post) => <Post post={post} />)}
        </ul>
      </section>

      <section id="podcasts" class="flex flex-col gap-6">
        <Pill><Icon name="mdi:microphone" class="size-4" /> Podcasts</Pill>
        <Podcasts />
      </section>

      <section id="presentations" class="flex flex-col gap-6">
        <Pill
          ><Icon name="mdi:presentation" class="size-4" /> Presentations</Pill
        >
        <Presentations />
      </section>

      <section id="projects" class="flex flex-col gap-6">
        <Pill
          ><Icon name="mdi:language-javascript" class="size-4" /> Projects</Pill
        >
        <MyWork />
      </section>

      <section id="timeline" class="flex flex-col gap-6">
        <Pill><Icon name="mdi:work" class="size-4" /> Work</Pill>
        <Timeline />
      </section>

      <section id="setup" class="relative flex flex-col gap-6">
        <span id="consoles" aria-hidden="true" class="absolute top-0"></span>
        <Pill><Icon name="mdi:keyboard-outline" class="size-4" /> Gear</Pill>
        <GearGallery />
      </section>

      <section id="software" class="flex flex-col gap-6">
        <Pill><Icon name="mdi:apps" class="size-4" /> Software</Pill>
        <Software />
      </section>
    </div>
  </main>
  <ProductPreview />
  <DesktopDestroyer />
</Layout>

<style>
  .section-link {
    --section-visibility: 0;
    position: relative;
    color: rgb(163 163 163);
    isolation: isolate;
  }

  .section-link::before {
    position: absolute;
    inset: 0;
    color: rgb(186 230 253);
    content: attr(data-label);
    opacity: var(--section-visibility);
    pointer-events: none;
    transition: opacity 100ms linear;
  }

  .section-link::after {
    position: absolute;
    top: 50%;
    left: -0.75rem;
    width: 2px;
    height: 1em;
    border-radius: 999px;
    background: rgb(125 211 252);
    content: "";
    opacity: var(--section-visibility);
    pointer-events: none;
    transform: translateY(-50%) scaleY(calc(0.7 + var(--section-visibility) * 0.3));
    transform-origin: center;
    transition:
      opacity 100ms linear,
      transform 160ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .section-link:focus-visible::before {
    color: white;
    opacity: 1;
  }

  @media (hover: hover) and (pointer: fine) {
    .section-link:hover::before {
      color: white;
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .section-link::before,
    .section-link::after {
      transition: opacity 100ms linear;
    }

    .section-link::after {
      transform: translateY(-50%);
    }
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const sectionWindow = window as Window & {
      sectionNavigationController?: AbortController;
    };
    sectionWindow.sectionNavigationController?.abort();

    const navigation = document.querySelector<HTMLElement>("[data-section-navigation]");
    if (!navigation) return;

    const controller = new AbortController();
    sectionWindow.sectionNavigationController = controller;
    const items: Array<{
      link: HTMLAnchorElement;
      section: HTMLElement;
      visibility: number;
    }> = [];

    navigation.querySelectorAll<HTMLAnchorElement>("[data-section-link]").forEach((link) => {
      const section = document.getElementById(decodeURIComponent(link.hash.slice(1)));
      if (section) items.push({ link, section, visibility: -1 });
    });

    let frame = 0;

    const updateNavigation = () => {
      frame = 0;
      const viewportHeight = window.innerHeight;
      let currentItem = items[0];

      items.forEach((item) => {
        const rect = item.section.getBoundingClientRect();
        const visibleStart = Math.max(rect.top, 0);
        const visibleEnd = Math.min(rect.bottom, viewportHeight);
        const visiblePixels = Math.max(0, visibleEnd - visibleStart);
        const referenceHeight = Math.min(rect.height, viewportHeight);
        const visibility = referenceHeight > 0
          ? Math.min(1, visiblePixels / referenceHeight)
          : 0;

        if (Math.abs(visibility - item.visibility) > 0.001) {
          item.visibility = visibility;
          item.link.style.setProperty("--section-visibility", visibility.toFixed(3));
        }

        if (!currentItem || visibility > currentItem.visibility) currentItem = item;
      });

      items.forEach((item) => {
        if (item === currentItem && item.visibility > 0) {
          item.link.setAttribute("aria-current", "location");
        } else {
          item.link.removeAttribute("aria-current");
        }
      });
    };

    const scheduleUpdate = () => {
      if (frame) return;
      frame = requestAnimationFrame(updateNavigation);
    };

    window.addEventListener("scroll", scheduleUpdate, {
      passive: true,
      signal: controller.signal,
    });
    window.addEventListener("resize", scheduleUpdate, { signal: controller.signal });
    controller.signal.addEventListener("abort", () => cancelAnimationFrame(frame));
    updateNavigation();
  });
</script>
